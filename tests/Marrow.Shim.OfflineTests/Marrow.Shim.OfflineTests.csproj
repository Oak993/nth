<Project Sdk="Microsoft.NET.Sdk">
  <!-- SK-6: offline Linux acceptance when unrelated Windows/voice packages are unavailable.
       Compiles the identical Services sources and acceptance tests, without a substitute implementation. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <Using Include="Xunit" />
    <Compile Include="..\Marrow.Services.Tests\Port\Skills\Shims\*.cs" Link="Tests\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\Marrow.Services\Port\Skills\Shims\*.cs" Link="Shims\%(Filename)%(Extension)" />
    <!-- ShimDefinition.Read resolves a routed sidecar through PipelineRoutingReader (7d9eda362), so the offline project compiles the same three
         BCL-only Pipelines sources src/Marrow.Shim already links. -->
    <Compile Include="..\..\src\Marrow.Services\Port\Skills\Pipelines\PipelineRoute.cs" Link="Pipelines\PipelineRoute.cs" />
    <Compile Include="..\..\src\Marrow.Services\Port\Skills\Pipelines\PipelineJsonContext.cs" Link="Pipelines\PipelineJsonContext.cs" />
    <Compile Include="..\..\src\Marrow.Services\Port\Skills\Pipelines\PipelineRoutingReader.cs" Link="Pipelines\PipelineRoutingReader.cs" />
    <ProjectReference Include="..\Marrow.Shim.FakeTarget\Marrow.Shim.FakeTarget.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Marrow.Shim\Marrow.Shim.csproj" ReferenceOutputAssembly="false" AdditionalProperties="PublishAot=false" />
  </ItemGroup>
  <Target Name="CopyShimFixtures" AfterTargets="Build">
    <ItemGroup>
      <ShimFixture Include="..\Marrow.Shim.FakeTarget\bin\$(Configuration)\net10.0\*" />
      <ShimLauncher Include="..\..\src\Marrow.Shim\bin\$(Configuration)\net10.0\*" />
    </ItemGroup>
    <Copy SourceFiles="@(ShimFixture)" DestinationFolder="$(OutDir)shim-fixture" />
    <Copy SourceFiles="@(ShimLauncher)" DestinationFolder="$(OutDir)shim-launcher" />
  </Target>
</Project>
