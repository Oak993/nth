{"id":"08-pomodoro","prompt":"Make me a Pomodoro timer page I can keep using.","expect":"artifact","events":[{"method":"turn/started","params":{"threadId":"t1","turn":{"id":"turn-1"}}},{"method":"item/started","params":{"threadId":"t1","turnId":"turn-1","item":{"type":"agentMessage","id":"m08","text":""}}},{"method":"item/agentMessage/delta","params":{"threadId":"t1","turnId":"turn-1","itemId":"m08","delta":"A minimal Pomodoro timer."}},{"method":"item/completed","params":{"threadId":"t1","turnId":"turn-1","item":{"type":"agentMessage","id":"m08","text":"A minimal Pomodoro timer."}}},{"method":"item/started","params":{"threadId":"t1","turnId":"turn-1","item":{"type":"mcpToolCall","id":"call08","server":"nth-ui","tool":"artifact_create","arguments":{"kind":"html","title":"Pomodoro timer","content":"<!doctype html>\n<meta charset=\"utf-8\">\n<title>Pomodoro</title>\n<h1 id=\"t\">25:00</h1>\n<button onclick=\"start()\">Start</button>\n<script>\nlet s=1500;\nfunction start(){setInterval(()=>{s--;t.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0')},1000)}\n</script>\n"},"status":"inProgress"}}},{"method":"item/completed","params":{"threadId":"t1","turnId":"turn-1","item":{"type":"mcpToolCall","id":"call08","server":"nth-ui","tool":"artifact_create","arguments":{"kind":"html","title":"Pomodoro timer","content":"<!doctype html>\n<meta charset=\"utf-8\">\n<title>Pomodoro</title>\n<h1 id=\"t\">25:00</h1>\n<button onclick=\"start()\">Start</button>\n<script>\nlet s=1500;\nfunction start(){setInterval(()=>{s--;t.textContent=Math.floor(s/60)+':'+String(s%60).padStart(2,'0')},1000)}\n</script>\n"},"status":"completed","result":{"content":[{"type":"text","text":"Done."}]}}}}]}
