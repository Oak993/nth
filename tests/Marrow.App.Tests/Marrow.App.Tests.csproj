<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Marrow.Testing\Marrow.Testing.csproj" />
    <ProjectReference Include="..\..\src\Marrow.App\Marrow.App.csproj" />
    <ProjectReference Include="..\..\src\Marrow.UI\Marrow.UI.csproj" />
    <ProjectReference Include="..\..\src\Marrow.Services\Marrow.Services.csproj" />
    <ProjectReference Include="..\..\src\Marrow.Core\Marrow.Core.csproj" />
    <!-- Marrow.Services.Tests.Fixtures.ForgeFixtures (ForgeStandIns/ForgeScript): the scripted, offline glab/gh/tea
         stand-in used by L4c's own-branch merge regression test (PR-HYDRAMERGE-127/-128). -->
    <ProjectReference Include="..\Marrow.Services.Tests\Marrow.Services.Tests.csproj" />
  </ItemGroup>

  <!-- WL-5: checked-in, offline source-oracle fixtures. No generator runs during build or test. -->
  <ItemGroup>
    <None Include="..\fixtures\wallpapers\reference\**\*" Link="fixtures\wallpapers\reference\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
