<Project Sdk="Microsoft.NET.Sdk">

  <!--
    P3 (task packet T-M0-002): Avalonia AcrylicBlur window edge over live desktop content, and the
    WS_EX_LAYERED trap. A throwaway probe, never production code.

    Built the way P10 is built: this folder sits under the repo root, so Directory.Build.props
    (TreatWarningsAsErrors, Nullable, ManagePackageVersionsCentrally) and Directory.Packages.props
    (Avalonia 12.1.2) apply, and no PackageReference carries a Version attribute.
    Avalonia.Desktop is the real Win32 platform backend (P1 and P10 were headless).
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>P3</RootNamespace>
    <AssemblyName>p3</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

</Project>
