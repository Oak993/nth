<Project>
  <!--
    Every package version in the solution is pinned here and nowhere else.
    Avalonia is PINNED deliberately: the glass compositor depends on ISkiaSharpApiLeaseFeature,
    which is [Unstable] with no cross-minor compatibility promise (ADR-0002, deviation 3).
    Any change to these versions is an orchestrator decision, gated behind the probe P10
    screenshot regression harness. Worker models must not edit this file.
  -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.2" />
    <!-- OD-0009: the text face is Inter (measured closer to the Mac oracle than Segoe UI Variable, probe P9 INTER.md). -->
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- OD-0062 / ED-235: the Velopack per-user installer. Keep this equal to the vpk tool's version (vpk 1.2.161): vpk packs the
         app with its own Update.exe and warns when the library in the app differs. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <!-- Voice typing (OD-0091, OD-0092; voice SPEC V-3.1, unit VT-0): the managed Whisper wrapper, its two shipped native runtimes
         (CPU and Vulkan; Q-V-9 C keeps CUDA out of the installer) and the WASAPI capture library. Pinned by the VT-0 unit on the
         lead's delegation (the header above still holds for every other worker). -->
    <PackageVersion Include="Whisper.net" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime" Version="1.9.1" />
    <PackageVersion Include="Whisper.net.Runtime.Vulkan" Version="1.9.1" />
    <PackageVersion Include="NAudio.Wasapi" Version="3.1.0" />
    <!-- Web surfaces W7 (DESIGN 2.1, ED-NEW-web-W7-1): Avalonia's MIT web view in HWND mode (12.1.0 is the newest 12.1.x; it
         depends on Avalonia >= 12.0.0, so the pinned 12.1.2 holds) and the managed WebView2 SDK, whose CoreWebView2 wraps the
         adapter's raw ICoreWebView2 for permissions, downloads and the DevTools Protocol. Pinned by W7 on the lead's delegation
         (owner approval of the web surfaces, 2026-10-11); spikes (a) and (i) confirm them on the owner's PC. -->
    <PackageVersion Include="Avalonia.Controls.WebView" Version="12.1.0" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
