<Project>
  <!--
    Every package version in the solution is pinned here and nowhere else.
    Avalonia is PINNED deliberately: the glass compositor depends on ISkiaSharpApiLeaseFeature,
    which is [Unstable] with no cross-minor compatibility promise (ADR-0002, deviation 3).
    Any change to these versions is an orchestrator decision, gated behind the probe P10
    screenshot regression harness. Worker models must not edit this file.
  -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.2" />
    <!-- OD-0009: the text face is Inter (measured closer to the Mac oracle than Segoe UI Variable, probe P9 INTER.md). -->
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <!-- OD-0062 / ED-235: the Velopack per-user installer. Keep this equal to the vpk tool's version (vpk 1.2.161): vpk packs the
         app with its own Update.exe and warns when the library in the app differs. -->
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>
</Project>
