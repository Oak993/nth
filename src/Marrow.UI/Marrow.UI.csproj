<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Marrow.Core\Marrow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Controls.WebView" />
  </ItemGroup>

  <ItemGroup>
    <!-- ED-107, OD-0020: Cascadia Mono ships inside the app (porting/probes/p9/CASCADIA.md). -->
    <AvaloniaResource Include="Assets/Fonts/**" />
    <AvaloniaResource Include="Assets/Icons/**" />
    <AvaloniaResource Include="Assets/Images/**" />
    <!-- Web surfaces W16c: the offline basemap of the `map` component (Natural Earth, public domain; Assets/naturalearth/README.txt). -->
    <AvaloniaResource Include="Assets/naturalearth/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- OD-0110: ship the source catalogue verbatim; shaders are mechanically translated at load time. -->
    <EmbeddedResource Include="../../porting/first-release/design-src/wallpaper-library/static/wallpapers.json" LogicalName="Marrow.Wallpapers.static.json" />
    <EmbeddedResource Include="../../porting/first-release/design-src/wallpaper-library/animated/wallpapers.json" LogicalName="Marrow.Wallpapers.animated.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
