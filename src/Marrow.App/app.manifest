<?xml version="1.0" encoding="utf-8"?>
<!--
  ED-NEW-lean-22 (lean unit L22). Replaces the SDK's default manifest (which carried only the identity and asInvoker below)
  and adds exactly two things: the Windows 10/11 supportedOS entry and the segment heap for the process's native heaps
  (Skia, HarfBuzz, ANGLE/D3D, the CRT). No DPI settings: Avalonia sets the DPI awareness itself at startup.
  Nothing else goes here; AppManifestTests pins the full element set.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity version="1.0.0.0" name="MyApplication.app" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <heapType xmlns="http://schemas.microsoft.com/SMI/2020/WindowsSettings">SegmentHeap</heapType>
    </windowsSettings>
  </application>
</assembly>
