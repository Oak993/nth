{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "state", "prices"],
  "properties": {
    "schemaVersion": {"const": 1},
    "state": {"enum": ["unfilled", "filled"]},
    "prices": {"type": "array", "items": {
      "type": "object",
      "required": ["service", "model", "inputUsdPerMillion", "outputUsdPerMillion", "requestUsd", "retrievedAt", "sourceUrl", "sourceSha256", "evidence"],
      "properties": {
        "service": {"enum": ["deepseek", "meta", "zai"]},
        "model": {"type": "string", "minLength": 1},
        "inputUsdPerMillion": {"type": "number", "minimum": 0},
        "outputUsdPerMillion": {"type": "number", "minimum": 0},
        "cachedInputUsdPerMillion": {"type": ["number", "null"], "minimum": 0},
        "requestUsd": {"type": "number", "minimum": 0},
        "maximumInputTokens": {"type": ["integer", "null"], "minimum": 1},
        "maximumOutputTokens": {"type": ["integer", "null"], "minimum": 1},
        "retrievedAt": {"type": "string", "format": "date-time"},
        "sourceUrl": {"type": "string", "format": "uri", "pattern": "^https://(api-docs\\.deepseek\\.com|dev\\.meta\\.ai|docs\\.z\\.ai)/"},
        "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence": {"type": "object"}
      }
    }}
  },
  "allOf": [{"if": {"properties": {"state": {"const": "unfilled"}}}, "then": {"properties": {"prices": {"maxItems": 0}}}}]
}
