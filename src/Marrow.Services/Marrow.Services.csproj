<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Marrow.Core\Marrow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Voice typing (voice SPEC V-3.1, VT-0). The two runtime packages carry the whisper.cpp natives (CPU: runtimes\win-x64; Vulkan: runtimes\vulkan\win-x64; the target below keeps only those). -->
    <PackageReference Include="Whisper.net" />
    <PackageReference Include="Whisper.net.Runtime" />
    <PackageReference Include="Whisper.net.Runtime.Vulkan" />
    <PackageReference Include="NAudio.Wasapi" />
    <!-- Web surfaces W7 (ED-NEW-web-w7-1): only the managed Core assembly and the x64 loader. The package's build targets
         also reference its WPF and WinForms assemblies, whose WindowsBase conflicts with this project (MSB3277), and its
         native assets put a WebView2Loader.dll for every platform under runtimes\ (win-arm64 and win-x86 too); both are
         excluded. Core is referenced directly, and the win-x64 loader is copied beside the app, where the Core assembly's
         DllImport of WebView2Loader.dll finds it. The package has no dependencies. -->
    <PackageReference Include="Microsoft.Web.WebView2" ExcludeAssets="build;buildTransitive;native" GeneratePathProperty="true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Web.WebView2.Core">
      <HintPath>$(PkgMicrosoft_Web_WebView2)\lib_manual\netcoreapp3.0\Microsoft.Web.WebView2.Core.dll</HintPath>
    </Reference>
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\WebView2Loader.dll" Link="WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Port\ModelsPalette\pack.v1.json.gz" LogicalName="Marrow.Services.ModelsPalette.Pack1.gz" />
    <!-- Web surfaces W13: nth's sandbox scripts ship inside the assembly; the vendored artifact libraries (built by
         tools/artifact-libs/build.mjs, each with its licence) are copied beside the app under Assets\lib. -->
    <EmbeddedResource Include="Web\Sandbox\*.js" LogicalName="Marrow.Services.Web.Sandbox.%(Filename)%(Extension)" />
    <None Update="Assets\lib\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- VT-0 (V-3.4, V-3.5): the bundled VAD model and the self-test clip are copied beside the app, to the build output and to the
         publish folder, under Port\Voice\Assets. voice-pins.json (the developer record of the pins) stays in the repository: it holds
         the owner PC's paths and hardware and review notes, and V-3.4 and V-3.5 bundle only these two files (ENGINEERING DECISION,
         ED-287 item 13). -->
    <None Update="Port\Voice\Assets\ggml-silero-v6.2.0.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Port\Voice\Assets\selftest-clip.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    VT-0 (V-3.2, Q-V-9 C): the Whisper.net runtime packages put every platform's natives in the build output (win-arm64, win-x86, Linux
    and, through the Metal dependency, macOS), 126 MB for a Windows x64 app. The Windows port ships the win-x64 CPU runtime
    (runtimes\win-x64) and the win-x64 Vulkan runtime (runtimes\vulkan\win-x64) only; every other runtimes\ file is taken off the copy list
    before the target paths are assigned, so it reaches neither this project's output, nor an app that references it, nor a publish
    folder. CUDA is not shipped (Q-V-9 C): it is a separate download that the loader finds through RuntimeOptions.LibraryPath.
  -->
  <Target Name="MarrowTrimWhisperNatives" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="'%(None.TargetPath)' != '' And $([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/', System.StringComparison.Ordinal)) And !$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/win-x64/', System.StringComparison.Ordinal)) And !$([System.String]::Copy('%(None.TargetPath)').StartsWith('runtimes/vulkan/win-x64/', System.StringComparison.Ordinal))" />
    </ItemGroup>
  </Target>

</Project>
