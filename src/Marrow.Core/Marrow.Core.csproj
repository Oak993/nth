<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks> <!-- ED-NEW-inst-c7-7: generated LibraryImport disconnect probe -->
  </PropertyGroup>

  <ItemGroup>
    <!-- ED-251 (OD-0089): border-beam 1.4.1's tables (MIT, Jakub Antalik), read out of its published dist/index.es.js. -->
    <EmbeddedResource Include="Models\ComposerLights\border-beam-tables.json" LogicalName="Marrow.Core.BorderBeamTables.json" />
    <!-- ED-294 (unit SK-1): the skills and tools catalogue, compiled in and never fetched at run time (ONDEMAND-PLAN.md 2.3). -->
    <EmbeddedResource Include="Port\Skills\Catalogue\catalogue.json" LogicalName="Marrow.Core.SkillsCatalogue.json" />
    <EmbeddedResource Include="Port\ModelsPalette\palette-source1.json" LogicalName="Marrow.Core.ModelsPalette.Source1.json" />
    <EmbeddedResource Include="Port\ModelsPalette\psl-icann.txt" LogicalName="Marrow.Core.ModelsPalette.PslIcann.txt" />
    <EmbeddedResource Include="Port\ModelsPalette\toc-source1.json" LogicalName="Marrow.Core.ModelsPalette.Toc.json" />
    <!-- ED-NEW-web-w17-1 (unit W17): the nth-ui reference page, compiled in as the on-demand skill (ui_reference) models read. -->
    <EmbeddedResource Include="..\..\docs\nth-ui.md" LogicalName="Marrow.Core.NthUiReference.md" />
    <!-- ED-NEW-web-w22-1 (unit W22): the words nth writes itself, one JSON file per area and language, and the guarded-action words, one file per language. -->
    <EmbeddedResource Include="Localisation\Strings\*.json" LogicalName="Marrow.Core.Strings.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Localisation\Guarded\*.json" LogicalName="Marrow.Core.Guarded.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
